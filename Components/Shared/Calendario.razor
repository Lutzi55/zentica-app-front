@* Calendario mensual (semana de lunes a domingo).
   ClaseDia permite pintar días (ej. "marcado" para guardias). *@
<div class="cal">
    <div class="cal-cab">
        <button type="button" class="btn-icono" @onclick="() => CambiarMes(-1)"><i class="bi bi-chevron-left"></i></button>
        <strong>@Formato.Mes(Mes)</strong>
        <button type="button" class="btn-icono" @onclick="() => CambiarMes(1)"><i class="bi bi-chevron-right"></i></button>
    </div>
    <div class="cal-grid">
        @foreach (var d in new[] { "L", "M", "M", "J", "V", "S", "D" })
        {
            <div class="cal-sem">@d</div>
        }
        @for (int i = 0; i < Desfase; i++)
        {
            <div></div>
        }
        @for (int i = 1; i <= DateTime.DaysInMonth(Mes.Year, Mes.Month); i++)
        {
            var fecha = new DateTime(Mes.Year, Mes.Month, i);
            var deshabilitado = !PermitirPasado && fecha < DateTime.Today;
            <div class="@Clase(fecha, deshabilitado)" @onclick="() => Click(fecha, deshabilitado)">@i</div>
        }
    </div>
    @ChildContent
</div>

@code {
    // Primer día del mes que se muestra
    [Parameter] public DateTime Mes { get; set; } = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    [Parameter] public EventCallback<DateTime> MesChanged { get; set; }
    [Parameter] public DateTime? Seleccionado { get; set; }
    [Parameter] public EventCallback<DateTime> OnDiaClick { get; set; }
    [Parameter] public Func<DateTime, string?>? ClaseDia { get; set; }
    [Parameter] public bool PermitirPasado { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private int Desfase => ((int)Mes.DayOfWeek + 6) % 7; // lunes = 0

    private string Clase(DateTime fecha, bool deshabilitado)
    {
        var c = "cal-dia";
        if (fecha == DateTime.Today) c += " hoy";
        if (deshabilitado) return c + " deshabilitado";
        if (Seleccionado?.Date == fecha) return c + " seleccionado";
        var extra = ClaseDia?.Invoke(fecha);
        return string.IsNullOrEmpty(extra) ? c : $"{c} {extra}";
    }

    private async Task Click(DateTime fecha, bool deshabilitado)
    {
        if (!deshabilitado) await OnDiaClick.InvokeAsync(fecha);
    }

    private async Task CambiarMes(int delta)
    {
        Mes = Mes.AddMonths(delta);
        await MesChanged.InvokeAsync(Mes);
    }
}
