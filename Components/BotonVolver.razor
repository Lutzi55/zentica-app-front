@inject IJSRuntime JS
@inject NavigationManager Nav

@* Vuelve a la pantalla anterior. Si se indica "Ruta", navega directo a esa ruta. *@
<button type="button" class="btn-volver" @onclick="Volver" title="Volver">
    <i class="bi bi-arrow-left"></i>
</button>

@code {
    [Parameter] public string? Ruta { get; set; }

    private async Task Volver()
    {
        if (!string.IsNullOrEmpty(Ruta)) Nav.NavigateTo(Ruta);
        else await JS.InvokeVoidAsync("history.back");
    }
}
