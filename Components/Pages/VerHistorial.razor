@page "/doctor/historial/{IdMascota:int}"
@layout LayoutDoctor
@inject ApiService Api

<div class="pantalla">
    <Encabezado Titulo="Historial Clínico" Subtitulo="@mascota?.Nombre" />

    <Aviso Cargando="cargando" Error="@error" />

    @if (!cargando && mascota != null)
    {
        <div class="segmentado mb-3">
            <button class="@(pestania == 0 ? "activo" : "")" @onclick="() => pestania = 0">Consultas</button>
            <button class="@(pestania == 1 ? "activo" : "")" @onclick="() => pestania = 1">Vacunas</button>
            <button class="@(pestania == 2 ? "activo" : "")" @onclick="() => pestania = 2">Recetas</button>
        </div>

        @if (pestania == 0)
        {
            @if (!consultas.Any())
            {
                <Vacio Icono="bi-journal-x" Texto="Todavía no hay consultas registradas." />
            }
            else
            {
                <select class="input-z mb-3" @bind="idConsulta">
                    @foreach (var c in consultas)
                    {
                        <option value="@c.IdConsulta">Consulta del @Formato.Fecha(c.Fecha)</option>
                    }
                </select>

                @if (Seleccionada is { } sel)
                {
                    <div class="card-z">
                        <div class="fila-botones">
                            <div><span class="texto-gris d-block">Paciente</span><strong>@mascota.Nombre</strong></div>
                            <div><span class="texto-gris d-block">Raza</span><strong>@mascota.Raza</strong></div>
                        </div>
                        <div class="fila-botones mt-2">
                            <div><span class="texto-gris d-block">Motivo de turno</span><strong>@(sel.Motivo ?? "-")</strong></div>
                            <div><span class="texto-gris d-block">Fecha</span><strong>@Formato.FechaHora(sel.Fecha)</strong></div>
                        </div>
                        <div class="fila-botones mt-2">
                            <div><span class="texto-gris d-block">Veterinario</span><strong>@sel.Doctor</strong></div>
                            <div><span class="texto-gris d-block">Costo</span><strong>@Formato.Plata(sel.Costo)</strong></div>
                        </div>
                        <span class="texto-gris d-block mt-3 mb-1">Diagnóstico / Observaciones</span>
                        <div class="caja-texto">@sel.Diagnostico</div>
                    </div>
                }
            }
        }
        else if (pestania == 1)
        {
            <ListaVacunas Vacunas="vacunas" />
        }
        else
        {
            @if (!recetas.Any())
            {
                <Vacio Icono="bi-capsule" Texto="No hay recetas emitidas." />
            }
            @foreach (var r in recetas)
            {
                <div class="card-z">
                    <h6>@r.Medicamento</h6>
                    <span class="texto-gris d-block">Emitida el @Formato.Fecha(r.FechaEmision) por @r.Doctor</span>
                    @if (r.FechaVencimiento.HasValue)
                    {
                        <span class="texto-gris">Vence: @Formato.Fecha(r.FechaVencimiento)</span>
                    }
                </div>
            }
        }

        <div class="text-center mt-3">
            <span class="chip chip-gris"><i class="bi bi-lock-fill"></i> Solo lectura</span>
        </div>
    }
</div>

@code {
    [Parameter] public int IdMascota { get; set; }

    private Mascota? mascota;
    private List<Consulta> consultas = new();
    private List<Vacuna> vacunas = new();
    private List<Receta> recetas = new();
    private int idConsulta, pestania;
    private bool cargando = true;
    private string? error;

    private Consulta? Seleccionada => consultas.FirstOrDefault(c => c.IdConsulta == idConsulta);

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        mascota = await Api.GetAsync<Mascota>($"api/mascotas/{IdMascota}");
        error = Api.UltimoError;
        if (mascota != null)
        {
            consultas = await Api.GetListaAsync<Consulta>($"api/servicios/mascota/{IdMascota}");
            vacunas = await Api.GetListaAsync<Vacuna>($"api/vacunas/mascota/{IdMascota}");
            recetas = await Api.GetListaAsync<Receta>($"api/recetas/mascota/{IdMascota}");
            idConsulta = consultas.FirstOrDefault()?.IdConsulta ?? 0;
        }
        cargando = false;
    }
}
