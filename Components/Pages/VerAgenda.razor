@page "/doctor/agenda"
@layout LayoutDoctor
@inject NavigationManager Navigation
@inject ApiService Api

<div class="pantalla">
    <Encabezado Titulo="Mi Agenda" Volver="/doctor/home" />

    <div class="card-z d-flex justify-content-between align-items-center">
        <button class="btn-icono" @onclick="() => Mover(-1)"><i class="bi bi-chevron-left"></i></button>
        <div class="text-center">
            <strong>@Formato.FechaLarga(dia)</strong>
            @if (dia != DateTime.Today)
            {
                <div><a class="link-z" @onclick="() => Ir(DateTime.Today)">Ir a hoy</a></div>
            }
        </div>
        <button class="btn-icono" @onclick="() => Mover(1)"><i class="bi bi-chevron-right"></i></button>
    </div>

    <Aviso Cargando="cargando" Error="@error" />

    @if (!cargando && !turnos.Any())
    {
        <Vacio Icono="bi-calendar-heart" Texto="No tenés turnos para este día." />
    }

    @foreach (var t in turnos)
    {
        <div class="card-z">
            <div class="d-flex align-items-center gap-3">
                <div class="text-center">
                    <span class="chip chip-verde">@t.FechaYHora.ToString("HH:mm") hs</span>
                </div>
                <div class="flex-grow-1 min-w-0">
                    <h6 class="text-truncate">@t.Mascota <span class="texto-gris fw-normal">· @t.Raza</span></h6>
                    <span class="texto-gris">Motivo: @(t.Motivo ?? "-")</span>
                    <div class="texto-gris">Dueño: @t.Duenio</div>
                </div>
                <span class="@Formato.ClaseEstado(t.Estado)">@t.Estado</span>
            </div>
            @if (t.Estado is "Aceptado" or "Pendiente")
            {
                <button class="btn-z btn-bloque mt-3" @onclick='() => Navigation.NavigateTo($"/doctor/atender/{t.IdTurno}")'>
                    Atender Cita
                </button>
            }
        </div>
    }
</div>

@code {
    private DateTime dia = DateTime.Today;
    private List<Turno> turnos = new();
    private bool cargando = true;
    private string? error;

    protected override Task OnInitializedAsync() => Cargar();

    private Task Mover(int dias) => Ir(dia.AddDays(dias));

    private async Task Ir(DateTime nuevo)
    {
        dia = nuevo.Date;
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        var lista = await Api.GetListaAsync<Turno>($"api/turnos?fecha={dia:yyyy-MM-dd}");
        error = Api.UltimoError;
        // No se muestran los rechazados ni cancelados
        turnos = lista.Where(t => t.Estado is not ("Rechazado" or "Cancelado")).ToList();
        cargando = false;
    }
}
